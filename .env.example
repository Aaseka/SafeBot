# Required
DISCORD_TOKEN=

# Storage (Docker mounts /data)
SAFEBOT_DB=safebot.db

# Models (defaults shown)
SAFEBOT_TOX_MODEL=unitary/toxic-bert
SAFEBOT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SAFEBOT_TOX_CONCURRENCY=2

# Image moderation (NSFW model, OCR, QR codes). Set to 0 to save ~400 MB RAM.
SAFEBOT_IMAGE_MODERATION=1
SAFEBOT_NSFW_MODEL=Falconsai/nsfw_image_detection
SAFEBOT_OCR=1

# Optional LLM judge + /ask answers. Any OpenAI-compatible API.
# Groq (free tier):  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
# Local Ollama:      LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=llama3.1:8b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
